      "resolved": "packages/validation",
      "link": true
    },
    "packages/api-client": {
      "name": "@prepilot/api-client",
      "version": "0.1.0"
    },
    "packages/design-tokens": {
      "name": "@prepilot/design-tokens",
      "version": "0.1.0"
    },
    "packages/shared-types": {
      "name": "@prepilot/shared-types",
      "version": "0.1.0"
    },
    "packages/validation": {
